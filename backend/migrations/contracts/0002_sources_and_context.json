    "views": [
      [
        "available_source_revisions",
        " SELECT d.id AS document_id,\n    d.owner_id,\n    r.id AS revision_id,\n    r.mode,\n    r.limitations\n   FROM (documents d\n     JOIN source_revisions r ON (((r.id = d.published_revision) AND (r.document_id = d.id))))\n  WHERE (d.ready AND (NOT d.deleted) AND (r.status = 'published'::text) AND r.upload_complete AND ((r.mode = 'complete'::text) OR (r.skip_confirmed AND (jsonb_array_length(r.limitations) > 0))) AND (( SELECT count(*) AS count\n           FROM source_pages p\n          WHERE (p.revision_id = r.id)) = r.page_count) AND (NOT (EXISTS ( SELECT 1\n           FROM source_pages p\n          WHERE ((p.revision_id = r.id) AND ((p.status <> 'ready'::text) OR (p.page > r.page_count)))))));"
      ]
    ],
    "functions": [
      [
        "protect_published_revision",
        "CREATE OR REPLACE FUNCTION public.protect_published_revision()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nDECLARE\n    previous_id uuid;\n    next_id uuid;\n    revision uuid;\nBEGIN\n    IF TG_OP<>'INSERT' THEN\n        previous_id := (to_jsonb(OLD)->>CASE WHEN TG_TABLE_NAME='source_revisions' THEN 'id' ELSE 'revision_id' END)::uuid;\n    END IF;\n    IF TG_OP<>'DELETE' THEN\n        next_id := (to_jsonb(NEW)->>CASE WHEN TG_TABLE_NAME='source_revisions' THEN 'id' ELSE 'revision_id' END)::uuid;\n    END IF;\n    FOR revision IN SELECT DISTINCT value FROM unnest(ARRAY[previous_id,next_id]) value WHERE value IS NOT NULL ORDER BY value LOOP\n        PERFORM id FROM source_revisions WHERE id=revision FOR SHARE;\n        IF EXISTS(SELECT 1 FROM documents WHERE published_revision=revision)\n            OR EXISTS(SELECT 1 FROM request_sources WHERE revision_id=revision) THEN\n            RAISE EXCEPTION 'Published source revision is immutable; create a new revision' USING ERRCODE='55000';\n        END IF;\n    END LOOP;\n    IF TG_OP='DELETE' THEN RETURN OLD; END IF;\n    RETURN NEW;\nEND;\n$function$\n"
      ]
    ]
